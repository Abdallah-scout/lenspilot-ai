# Copy this file to .env (git-ignored; loaded automatically) or export the values. Never commit real keys.
OPENAI_API_KEY=
LENSPILOT_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# Optional
LENSPILOT_MODEL=claude-opus-5-5
LENSPILOT_EFFORT=medium
LENSPILOT_DATA_DIR=
LENSPILOT_APPROVAL_SECRET=
# Free local model via Ollama (https://ollama.com): ollama pull llama3.1
LENSPILOT_OLLAMA_MODEL=lenspilot-qwen3
LENSPILOT_OLLAMA_URL=http://localhost:11434/v1
