# Copy this file to .env (git-ignored; loaded automatically) or export the values. Never commit real keys.
OPENAI_API_KEY=
LENSPILOT_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# Optional
LENSPILOT_MODEL=claude-opus-5-5
LENSPILOT_EFFORT=medium
LENSPILOT_DATA_DIR=
LENSPILOT_APPROVAL_SECRET=
# Free local model via Ollama (https://ollama.com): ollama pull llama3.1
LENSPILOT_OLLAMA_MODEL=lenspilot-qwen3
LENSPILOT_OLLAMA_URL=http://localhost:11434/v1
# google = the app uses only photos imported from Google Photos (no demo photos)
LENSPILOT_PHOTO_SOURCE=
# Local vision model for photo descriptions (import page): ollama pull qwen3-vl:8b
LENSPILOT_VISION_MODEL=qwen3-vl:8b
# LangSmith (optional, off unless LENSPILOT_LANGSMITH=1). Inputs/outputs are hidden by default.
LENSPILOT_LANGSMITH=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lenspilot
